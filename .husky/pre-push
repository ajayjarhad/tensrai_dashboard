export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use 24

# Run full build and tests before pushing
echo "🏗️  Running pre-push checks..."

# Clean build to ensure everything compiles
echo "🧹 Cleaning previous builds..."
# Not clean:build: a running `bun run dev` imports shared/dist, and deleting it stops the backend until
# it's restarted. The shared build below rewrites that folder anyway (tsc --build --force).
rm -rf frontend/dist backend/dist

# Build all packages in correct order
echo "📦 Building packages..."
bun run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed"
  exit 1
fi

# Final health check
echo "🏥 Running health check..."
bun run health-check
if [ $? -ne 0 ]; then
  echo "❌ Health check failed"
  exit 1
fi

echo "✅ All pre-push checks passed!"