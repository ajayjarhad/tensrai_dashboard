# Copy to .env.local to run `bun run dev` on this machine. The dev scripts load it over .env; Docker Compose ignores it.

NODE_ENV=development

# directConnection: Docker's replica set names its member "mongo", which only resolves inside Docker.
DATABASE_URL="mongodb://localhost:27017/tensrai_dashboard?replicaSet=rs0&directConnection=true"

# The backend's port. If 5055 is taken, change it on all of these lines.
PORT=5055
BASE_URL=http://localhost:5055
VITE_API_URL=http://localhost:5055/api
VITE_WS_URL=ws://localhost:5055/ws

FRONTEND_URL=http://localhost:5002
