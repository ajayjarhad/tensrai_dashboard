{
  "name": "backend",
  "version": "1.0.0",
  "description": "Robot dashboard backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "predev": "bun run --cwd ../shared build",
    "dev": "./scripts/mongoReplica.sh && bun --watch src/index.ts",
    "db:prepare": "./scripts/mongoReplica.sh && prisma db push --skip-generate && tsx scripts/backfillOrg.ts && (tsx scripts/seed.ts || echo 'Seeding skipped')",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "bun run --cwd ../shared build",
    "start": "./scripts/mongoReplica.sh && node dist/index.js",
    "generate": "DATABASE_URL=\"${DATABASE_URL:-mongodb://mongo:27017/tensrai_dashboard?replicaSet=rs0}\" prisma generate",
    "seed": "./scripts/mongoReplica.sh && tsx scripts/seed.ts",
    "seed:robots": "./scripts/mongoReplica.sh && tsx scripts/robotSeed.ts",
    "seed:maps": "./scripts/mongoReplica.sh && tsx scripts/seedMaps.ts",
    "seed:all": "./scripts/mongoReplica.sh && tsx scripts/seed.ts && tsx scripts/seedMaps.ts",
    "backfill:map-assets": "./scripts/mongoReplica.sh && tsx scripts/backfillMapAssets.ts",
    "backfill:org": "./scripts/mongoReplica.sh && tsx scripts/backfillOrg.ts",
    "org:create": "./scripts/mongoReplica.sh && tsx scripts/createOrg.ts",
    "staff:create": "./scripts/mongoReplica.sh && tsx scripts/createStaff.ts",
    "staff:default-password": "tsx scripts/setDefaultStaffPassword.ts",
    "dev:with-seed": "npm run seed:all && bun --watch src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "bun test src",
    "test:integration": "bun test integration"
  },
  "keywords": [
    "robotics",
    "dashboard",
    "ros",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/core": "1.4.4",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.0.1",
    "@jsquash/webp": "^1.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-prometheus": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@prisma/client": "^6.19.0",
    "@tensrai/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.3.34",
    "cookie": "^1.1.1",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.0.1",
    "js-yaml": "^4.1.1",
    "pino-pretty": "^13.1.2",
    "pngjs": "^7.0.0",
    "prisma": "^6.19.0",
    "roslib": "^1.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/roslib": "^1.3.6",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
