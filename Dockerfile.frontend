FROM oven/bun:1 AS builder

WORKDIR /app

# Build-time public frontend config.
ARG VITE_API_URL=/api
ARG VITE_WS_URL=/ws
ARG VITE_CLOUD_DASHBOARD=true

# Install workspace dependencies first for better layer caching.
COPY bun.lock package.json tsconfig.json ./
COPY frontend/package.json ./frontend/package.json
COPY shared/package.json ./shared/package.json
COPY backend/package.json ./backend/package.json

RUN bun install --frozen-lockfile

# Copy source after dependency layer.
COPY frontend ./frontend
COPY shared ./shared

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}
ENV VITE_CLOUD_DASHBOARD=${VITE_CLOUD_DASHBOARD}

# Produces /app/frontend/dist
RUN bun run --cwd frontend build

FROM nginx:1.27-alpine

RUN apk add --no-cache wget

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
